# Required application runtime settings
TAARA_DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE
TAARA_DB_USERNAME=YOUR_DB_USERNAME
TAARA_DB_PASSWORD=YOUR_DB_PASSWORD

TAARA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TAARA_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
TAARA_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
TAARA_SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
TAARA_SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Strongly recommended for first-run local access
TAARA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TAARA_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Optional overrides
TAARA_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TAARA_API_BASE_URL=/api
PORT=8080
